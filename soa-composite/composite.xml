<?xml version="1.0" encoding="UTF-8"?>
<composite name="FileProcessingComposite"
           revision="1.0"
           label="File Processing with Dual Entry Points"
           mode="active"
           state="on"
           xmlns="http://xmlns.oracle.com/sca/1.0"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:wsp="http://schemas.xmlsoap.org/ws/2004/09/policy"
           xmlns:ui="http://xmlns.oracle.com/soa/designer/">

    <!-- ================================================================== -->
    <!-- TEST PROJECT: File Adapter Patterns                                -->
    <!-- Demonstrates TWO entry paths to the same BPEL process:             -->
    <!-- 1. SOAP API: Java Client -> WSDL -> Service -> Component -> BPEL   -->
    <!-- 2. File Adapter: JCA -> Service -> Component -> BPEL               -->
    <!-- Both paths converge at the BPEL which calls File Adapter Outbound  -->
    <!-- ================================================================== -->

    <!-- Import WSDLs -->
    <import namespace="http://test.com/soa/fileprocessing"
            location="FileProcessingService.wsdl"
            importType="wsdl"/>
    <import namespace="http://test.com/soa/adapter/file"
            location="adapters/FileAdapter_Inbound.wsdl"
            importType="wsdl"/>
    <import namespace="http://test.com/soa/adapter/file"
            location="adapters/FileAdapter_Outbound.wsdl"
            importType="wsdl"/>

    <!-- ================================================================== -->
    <!-- ENTRY POINT 1: SOAP API Service                                    -->
    <!-- Chain: Java Client -> WSDL -> SOA_SERVICE -> SOA_COMPONENT -> BPEL -->
    <!-- ================================================================== -->

    <service name="FileProcessingService" ui:wsdlLocation="FileProcessingService.wsdl">
        <interface.wsdl interface="http://test.com/soa/fileprocessing#wsdl.interface(FileProcessingPortType)"/>
        <binding.ws port="http://test.com/soa/fileprocessing#wsdl.endpoint(fileprocessing_client_ep/FileProcessingPort)"/>
    </service>

    <!-- ================================================================== -->
    <!-- ENTRY POINT 2: File Adapter Inbound Service                        -->
    <!-- Chain: JCA_ADAPTER_INBOUND -> SOA_SERVICE -> SOA_COMPONENT -> BPEL -->
    <!-- Polls /data/incoming directory for new files                       -->
    <!-- ================================================================== -->

    <service name="FileAdapterInbound" ui:wsdlLocation="adapters/FileAdapter_Inbound.wsdl">
        <interface.wsdl interface="http://test.com/soa/adapter/file#wsdl.interface(Read_ptt)"/>
        <binding.jca config="adapters/FileAdapter_Inbound.jca"/>
    </service>

    <!-- ================================================================== -->
    <!-- BPEL Component                                                     -->
    <!-- Processes files from both SOAP API and File Adapter entry points   -->
    <!-- ================================================================== -->

    <component name="FileProcessingProcess" version="2.0">
        <implementation.bpel src="FileProcessingProcess.bpel"/>
        <componentType>
            <!-- Service Interfaces (entry points) -->
            <service name="FileProcessingService" ui:wsdlLocation="FileProcessingService.wsdl">
                <interface.wsdl interface="http://test.com/soa/fileprocessing#wsdl.interface(FileProcessingPortType)"/>
            </service>
            <service name="FileAdapterInbound" ui:wsdlLocation="adapters/FileAdapter_Inbound.wsdl">
                <interface.wsdl interface="http://test.com/soa/adapter/file#wsdl.interface(Read_ptt)"/>
            </service>

            <!-- References (outbound calls) -->
            <reference name="FileAdapterOutbound" ui:wsdlLocation="adapters/FileAdapter_Outbound.wsdl">
                <interface.wsdl interface="http://test.com/soa/adapter/file#wsdl.interface(Write_ptt)"/>
            </reference>
        </componentType>
    </component>

    <!-- ================================================================== -->
    <!-- OUTBOUND: File Adapter Reference                                   -->
    <!-- Chain: BPEL -> SOA_REFERENCE -> JCA_ADAPTER_OUTBOUND -> File       -->
    <!-- Writes processed files to /data/outgoing directory                 -->
    <!-- ================================================================== -->

    <reference name="FileAdapterOutbound" ui:wsdlLocation="adapters/FileAdapter_Outbound.wsdl">
        <interface.wsdl interface="http://test.com/soa/adapter/file#wsdl.interface(Write_ptt)"/>
        <binding.jca config="adapters/FileAdapter_Outbound.jca"/>
    </reference>

    <!-- ================================================================== -->
    <!-- Wiring                                                             -->
    <!-- ================================================================== -->

    <!-- SOAP API -> BPEL Component -->
    <wire>
        <source.uri>FileProcessingService</source.uri>
        <target.uri>FileProcessingProcess/FileProcessingService</target.uri>
    </wire>

    <!-- File Adapter Inbound -> BPEL Component -->
    <wire>
        <source.uri>FileAdapterInbound</source.uri>
        <target.uri>FileProcessingProcess/FileAdapterInbound</target.uri>
    </wire>

    <!-- BPEL Component -> File Adapter Outbound -->
    <wire>
        <source.uri>FileProcessingProcess/FileAdapterOutbound</source.uri>
        <target.uri>FileAdapterOutbound</target.uri>
    </wire>

</composite>
